# Required
TELEGRAM_BOT_TOKEN=123456:ABC-from-BotFather
ANTHROPIC_API_KEY=sk-ant-...

# Strongly recommended: only these chat IDs can use the bot (comma-separated).
# Start the bot once without it, send /start, and it tells you your chat ID.
ALLOWED_CHAT_IDS=

# Optional
YOUTUBE_API_KEY=            # better interview coverage (free from Google Cloud Console)
CLAUDE_MODEL=claude-haiku-5-5
CHECK_INTERVAL_MIN=20
NEWS_REGION=en-IN           # en-US, en-GB, ...
MAX_WATCHLIST_ITEMS=25
DB_PATH=watchlist.db
